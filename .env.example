# ─── Session (REQUIRED) ─────────────────────────────────────────
# Signing key for snt_session cookie.  Min 32 chars recommended.
# App will not start / login will return 503 without this value.
SESSION_SECRET=your-session-secret-here

# ─── Database ───────────────────────────────────────────────────
# At least one of the three should be set for PG-first mode.
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
DATABASE_URL=

# ─── KV / Redis (Upstash or Vercel KV) ─────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Telegram ───────────────────────────────────────────────────
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_ADMIN_CHAT_ID=

# ─── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Vercel Blob ────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Public URLs ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Cron ───────────────────────────────────────────────────────
CRON_SECRET=

# ─── QA / Dev ───────────────────────────────────────────────────
ENABLE_QA=
QA_SECRET=
STAFF_LOGIN_DIAG=
RATE_LIMIT_ENABLED=
FEATURE_QA_MODE=
FEATURE_PDF_GENERATION=
FEATURE_BULK_OPERATIONS=
FEATURE_IMPORTS_V2=

# ─── Playwright E2E тесты ───────────────────────────────────────
# Скопируйте этот файл в .env.local и заполните реальными значениями

# Базовый URL для E2E тестов (по умолчанию http://localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Коды доступа для тестовых пользователей
TEST_ACCESS_CODE=1111
TEST_ADMIN_CODE=1233

# Креды для staff ролей (chairman, secretary, accountant)
# Для локального запуска E2E тестов с staff ролями
AUTH_USER_CHAIRMAN=председатель
AUTH_PASS_CHAIRMAN=your_password_here

AUTH_USER_SECRETARY=секретарь
AUTH_PASS_SECRETARY=your_password_here

AUTH_USER_ACCOUNTANT=бухгалтер
AUTH_PASS_ACCOUNTANT=your_password_here

# Telegram для отправки уведомлений (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Примечание:
# - Локально: если креды accountant не заданы, тесты accountant будут пропущены (skipped)
# - В CI: если креды accountant не заданы, тесты accountant упадут с ошибкой
